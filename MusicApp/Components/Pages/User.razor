@rendermode InteractiveServer
@using MusicApp.Components.Pages.Errors
@using MusicApp.Components.Pages.Shared

<PageTitle>User</PageTitle>

<div class="user-page">

@if (IsLoading)
{
    <Loading/>
}
else
{
    <div class="d-flex justify-content-center mb-4">
        <select class="form-select user-select"
                value="@SelectedClub"
                @onchange="OnClubChanged">
            <option value="">Select Club</option>
            @foreach (var club in Clubs ?? [])
            {
                <option value="@club.Id">@club.Location - @club.ClubName</option>
            }
        </select>
    </div>

    @if (SelectedClub != null)
    {
        @if (IsClubLoading)
        {
            <Loading/>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-warning text-center">
                    @ErrorMessage
                </div>
            }

            if (CurrentDjSet == null)
            {
                <div class="alert alert-warning text-center">
                    No DJ performing at the moment
                </div>
            }
            else
            {
                <div class="user-header">
                    <h3>@CurrentClubName</h3>
                    <p>
                        @CurrentDjName<br/>
                        @CurrentDjSet?.PerformanceTimeStarts – @CurrentDjSet?.PerformanceTimeEnds
                    </p>
                </div>

                <div class="d-flex justify-content-center mb-4">
                    <button class="btn btn-primary btn-lg user-request-button"
                            @onclick="OpenRequestDialog">
                        🎵 Request a Song
                    </button>
                </div>

                <div class="user-card">
                    <h5 class="mb-3">Your Requests</h5>
                    <table class="table table-dark table-striped mb-0">
                        <thead>
                        <tr>
                            <th>Artist</th>
                            <th>Title</th>
                            <th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var song in PagedCurrentSongs)
                        {
                            <tr>
                                <td>@song.Author</td>
                                <td>@song.Title</td>
                                <td class="user-status" style="color:@GetStatusColor(song.Status?.Name)">
                                    @song.Status?.Name
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                     @if (TotalSongPages > 1)
                        {
                        <nav class="d-flex justify-content-center mt-2">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CurrentSongPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangeSongPage(CurrentSongPage - 1)">‹</button>
                                </li>
                                @for (int i = 1; i <= TotalSongPages; i++)
                                {
                                    <li class="page-item @(i == CurrentSongPage ? "active" : "")">
                                        @{
                                            var i1 = i;
                                        }
                                        <button class="page-link" @onclick="() => ChangeSongPage(i1)">@i</button>
                                    </li>
                                }
                                <li class="page-item @(CurrentSongPage == TotalSongPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangeSongPage(CurrentSongPage + 1)">›</button>
                                </li>
                            </ul>
                        </nav>
                        }
                </div>

                @if (UserPastClubSongs?.Any() == true)
                {
                    <div class="user-card">
                        <h5 class="mb-3">Past Requests</h5>
                        <table class="table table-dark table-striped mb-0">
                            <thead>
                            <tr>
                                <th>Artist</th>
                                <th>Title</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var song in PagedPastSongs)
                            {
                                <tr>
                                    <td>@song.Author</td>
                                    <td>@song.Title</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary w-100 shadow-sm user-past-button"
                                                @onclick="() => RequestPastSong(song)">
                                            Request again
                                        </button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                            @if (TotalPastSongPages > 1)
                            {
                                <nav class="d-flex justify-content-center mt-2">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(CurrentPastSongPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePastSongPage(CurrentPastSongPage - 1)">‹</button>
                                        </li>
                                        @for (int i = 1; i <= TotalPastSongPages; i++)
                                        {
                                            <li class="page-item @(i == CurrentPastSongPage ? "active" : "")">
                                                @{
                                                    var i1 = i;
                                                }
                                                <button class="page-link" @onclick="() => ChangePastSongPage(i1)">@i</button>
                                            </li>
                                        }
                                        <li class="page-item @(CurrentPastSongPage == TotalPastSongPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePastSongPage(CurrentPastSongPage + 1)">›</button>
                                        </li>
                                    </ul>
                                </nav>
                            }
                    </div>
                }
            }
        }
        
        <AppModal @bind-IsOpen="ShowRequestDialog">
            <div class="user-modal">
                <h4 class="text-center mb-3">🎶 Song Request</h4>

                <div style="position:relative;">
                    <input class="form-control mb-2 user-modal-input"
                           placeholder="Search song or artist..."
                           value="@_searchQuery"
                           @oninput="HandleInputChange"/>

                    @if (_showResults && _searchResults?.Any() == true)
                    {
                        <ul class="list-group user-modal-list">
                            @foreach (var song in _searchResults)
                            {
                                <li class="list-group-item list-group-item-action"
                                    @onclick="@(() => SelectSong(song))">
                                    <strong>@song.Artist</strong><br/>
                                    <small>@song.Title</small>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Artist</label>
                    <input class="form-control" @bind="NewSong.Author"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input class="form-control" @bind="NewSong.Title"/>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary w-50"
                            @onclick="CloseRequestDialog">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary w-50"
                            @onclick="SubmitRequest">
                        Submit
                    </button>
                </div>
            </div>
        </AppModal>
    }
}
</div>
